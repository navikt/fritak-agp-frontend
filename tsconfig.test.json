{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "typeRoots": ["./typings", "./node_modules/@types", "./node_modules"],
    "types": ["vitest/globals", "vite/client", "node"]
  },
  "include": [
    "src/**/*.test.*",
    "./vitest.setup.ts",
    "src/setupTests.ts",
    "typings/jest-axe.d.ts",
    "typings/vitest.d.ts"
  ],
  "exclude": ["src/mock/**/*", "src/mockData/**/*"]
}
