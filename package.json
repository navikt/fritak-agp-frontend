{
  "name": "fritak-agp-frontend",
  "version": "1.0.32",
  "private": true,
  "homepage": "/fritak-agp",
  "proxy": "http://localhost:8080",
  "type": "module",
  "scripts": {
    "dev": "vite  --host",
    "start": "vite",
    "start:host": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "lint": "eslint src/**/*.ts*",
    "lint:fix": "eslint src/**/*.ts* --fix",
    "prepare": "husky",
    "postinstall": "cross-os postinstall",
    "test:int": "playwright test",
    "test:watch": "vitest",
    "knip": "knip --no-exit-code --reporter json"
  },
  "cross-os": {
    "postinstall": {
      "darwin": "mkdir -p ./node_modules && touch ./node_modules/.metadata_never_index",
      "linux": "echo 'No postinstall script for Linux'",
      "win32": "echo 'No postinstall script for Windows'"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "engineStrict": true,
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "^2.9.0",
    "@grafana/faro-web-tracing": "^2.9.0",
    "@navikt/aksel-icons": "^8.16.1",
    "@navikt/ds-css": "^8.16.1",
    "@navikt/ds-react": "^8.16.1",
    "@navikt/fnrvalidator": "^2.2.1",
    "@navikt/nav-dekoratoren-moduler": "^3.7.3",
    "@navikt/textparser": "^2.5.0",
    "@navikt/virksomhetsvelger": "^2.0.5",
    "date-fns": "^4.4.0",
    "html-react-parser": "^6.1.5",
    "i18next": "^26.3.6",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.3",
    "@eslint/js": "^10.0.1",
    "@navikt/aksel": "^8.16.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jest-axe": "~3.5.9",
    "@types/node": "~24.12.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^4.1.10",
    "cross-os": "1.6.0",
    "eslint": "^10.8.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "~9.1.7",
    "jest-axe": "~11.0.0",
    "knip": "^6.32.0",
    "lint-staged": "^17.3.0",
    "mockdate": "^3.0.5",
    "msw": "^2.15.0",
    "prettier": "~3.9.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass-embedded": "^1.100.0",
    "timezone-mock": "~1.4.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "vitest-sonar-reporter": "^3.0.0"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
